# Point the client at your hosted game server (set this in Vercel > Settings > Environment Variables)
VITE_SERVER_URL=wss://your-gbam-server.fly.dev

# Protects the live analytics endpoint on the game server. Set a long random value.
ADMIN_TOKEN=replace-with-a-long-random-secret

# Exact origin that serves admin.html in production (for example, https://your-site.vercel.app)
ADMIN_ORIGIN=https://your-site.example

# Optional explicit HTTP URL for analytics; otherwise derived from VITE_SERVER_URL.
# VITE_ADMIN_API_URL=https://your-gbam-server.fly.dev
